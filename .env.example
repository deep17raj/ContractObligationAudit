# Copy to .env (never commit it) and `set -a; source .env; set +a` before running.

# --- Claude: the obligation-extraction layer.
# Without a key the service still answers: it falls back to the deterministic reader, which
# reads obligation-bearing clauses straight out of the text and reports them as
# `unverifiable`. Verdicts stay honest, citations stay verbatim; only the precision drops.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5    # claude-haiku-5-5 is the low-latency alternative
ANTHROPIC_EFFORT=low               # low | medium | high | xhigh | max
EXTRACTION_MODE=auto               # auto = use the model when a key exists | llm | off
# Server-side fallback when a safety classifier declines the request. Uses the beta messages
# endpoint; switch off on Bedrock/Vertex/Foundry, which need client-side middleware instead.
ENABLE_LLM_FALLBACKS=1

# --- Input resolution. Telegraph caps `contract` at 256 bytes on-chain, so routed callers
# often send a link rather than a document; resolving one is part of the core path.
ENABLE_URL_FETCH=1
MAX_FETCH_BYTES=8000000
MAX_REDIRECTS=3
# Leave this OFF. It is the SSRF guard: with it off, a supplied URL that resolves to a
# private, loopback or link-local address (cloud metadata endpoints included) is refused,
# and the check is repeated on every redirect hop.
ALLOW_PRIVATE_HOSTS=0

# --- Time budgets (seconds). The global cap is what keeps Telegraph from seeing a timeout.
GLOBAL_TIMEOUT_S=13.5
FETCH_TIMEOUT_S=6.0
LLM_TIMEOUT_S=8.0

# --- Cache (seconds)
CACHE_TTL_S=1800
CACHE_TTL_DEGRADED_S=30            # a fetch failure or a timeout is cached only briefly
CACHE_MAX_ITEMS=500

# --- Limits
MAX_CONTRACT_CHARS=120000          # longer contracts are truncated, and the summary says so
MAX_OBLIGATIONS=10
MAX_CLAUSES=12
MAX_CLAUSE_CHARS=600

LOG_LEVEL=INFO
# HTTP_USER_AGENT="YourBot/1.0 (https://your-site; ops contact)"
